# ISSATKr — LOCAL DEVELOPMENT configuration template.
# Copy to .env (never committed). For production use .env.production.example.

DATABASE_URL="file:./dev.db"
UPLOAD_DIR=./uploads
AUTH_SECRET=REPLACE_WITH_A_RANDOM_VALUE_OF_32_PLUS_CHARACTERS
ATTENDANCE_TIME_ZONE=Africa/Tunis

# Development seed only (npm run db:seed). Refused when NODE_ENV=production.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=CHOOSE_A_LOCAL_PASSWORD
PROF_EMAIL=prof@example.test
PROF_PASSWORD=CHOOSE_A_LOCAL_PASSWORD
CHEF_EMAIL=chef@example.test
CHEF_PASSWORD=CHOOSE_A_LOCAL_PASSWORD
DEMO_PASSWORD=CHOOSE_A_LOCAL_PASSWORD

# E-mails: "json" prints messages instead of sending them (no SMTP needed locally).
SMTP_TRANSPORT=json
SMTP_FROM="ISSATKr dev <dev@example.test>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

CRON_SECRET=REPLACE_WITH_A_RANDOM_VALUE_OF_16_PLUS_CHARACTERS
