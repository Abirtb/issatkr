# ISSATKr — PRODUCTION configuration template.
# Copy to .env.production ON THE SERVER, fill in, then: chmod 600 .env.production
# Never commit .env.production. Placeholders below are NOT valid values.

# --- Database (SQLite file inside the Docker volume) -------------------------
# Must NOT be the development database (prisma/dev.db). The app refuses to start
# with a development/test database or a missing value.
DATABASE_URL=file:/data/issatkr.db

# --- Uploaded justificatifs (inside the Docker volume, outside the web root) ---
UPLOAD_DIR=/data/uploads

# --- Sessions ------------------------------------------------------------------
# Random, 32+ characters. Generate on the server, e.g.: openssl rand -base64 48
# Changing it signs every user out.
AUTH_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48

# --- Attendance window time zone (default Africa/Tunis) ------------------------
ATTENDANCE_TIME_ZONE=Africa/Tunis

# --- Institutional SMTP (warning / elimination e-mails) ------------------------
SMTP_HOST=SMTP_HOST_PROVIDED_BY_THE_INSTITUTION
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SMTP_USERNAME
SMTP_PASSWORD=SMTP_PASSWORD
SMTP_FROM="ISSAT Kairouan <no-reply@YOUR_DOMAIN>"

# --- Notification retry job (POST /api/cron/notifications) ---------------------
# Random, 16+ characters: openssl rand -hex 32
CRON_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32

# --- Docker Compose (host side) -------------------------------------------------
# Loopback port Nginx proxies to. Read by compose from the shell or a .env file.
# APP_PORT=3000
